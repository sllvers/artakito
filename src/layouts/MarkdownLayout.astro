---
import Footer from '../components/Footer.astro';
import Layout from './Layout.astro';
import Nav from '../components/Nav.astro';
import { artist } from '../lib/content';

const { frontmatter } = Astro.props;
---

<Layout title={`${frontmatter?.title || 'Privacy Policy'} — ${artist.name}`}>
  <div class="page">
    <Nav />

    <main class="privacy-page">
      <slot />
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .privacy-page {
    flex: 1;
    padding: 120px clamp(20px, 5vw, 64px) 80px;
    max-width: 800px;
    margin: 0 auto;
    width: 100%;
  }

  .privacy-page :global(h1) {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    margin: 0 0 12px;
    letter-spacing: 0.02em;
  }

  .privacy-page :global(p), 
  .privacy-page :global(li) {
    font-size: 1.05rem;
    line-height: 1.75;
    margin: 0 0 20px;
  }

  .privacy-page :global(ul) {
    margin: 0 0 20px;
    padding-left: 24px;
  }

  .privacy-page :global(h2) {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
    margin: 40px 0 16px;
    color: var(--ink);
  }

  .privacy-page :global(a) {
    color: var(--accent);
    text-decoration: underline;
  }



</style>
