---
import Layout from './Layout.astro';
import Nav from '../components/Nav.astro';
import artist from '../data/artist.json';

const { frontmatter } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');
---

<Layout title={`${frontmatter?.title || 'Privacy Policy'} — ${artist.name}`}>
  <div class="page">
    <Nav />

    <main class="privacy-page">
      <slot />
    </main>

    <footer class="site-footer">
      <p class="fine">&copy; {new Date().getFullYear()} {artist.name} &bull; <a href={`${base}/privacy-policy`}>Privacy Policy</a></p>
    </footer>
  </div>
</Layout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .privacy-page {
    flex: 1;
    padding: 120px clamp(20px, 5vw, 64px) 80px;
    max-width: 800px;
    margin: 0 auto;
    width: 100%;
  }

  .privacy-page :global(h1) {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    margin: 0 0 12px;
    letter-spacing: 0.02em;
  }

  .privacy-page :global(p), 
  .privacy-page :global(li) {
    font-size: 1.05rem;
    line-height: 1.75;
    margin: 0 0 20px;
  }

  .privacy-page :global(ul) {
    margin: 0 0 20px;
    padding-left: 24px;
  }

  .privacy-page :global(h2) {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
    margin: 40px 0 16px;
    color: var(--ink);
  }

  .privacy-page :global(a) {
    color: var(--accent);
    text-decoration: underline;
  }

  .site-footer {
    border-top: 1px solid var(--line);
    padding: 32px clamp(20px, 5vw, 64px) 48px;
    text-align: center;
  }

  .fine {
    font-family: var(--font-label);
    font-size: 0.75rem;
    color: var(--umber);
  }

  .fine a {
    color: inherit;
    text-decoration: underline;
  }
</style>
