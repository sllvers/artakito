---
import artist from '../data/artist.json';

interface Props {
  catalog: string;
  title: string;
  year: string;
  medium: string;
  size: string;
  price: string;
  status: 'available' | 'sold';
  image: string;
}

const { catalog, title, year, medium, size, price, status, image } = Astro.props;
const isSold = status === 'sold';
const rawBase = import.meta.env.BASE_URL;
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');
const contactUrl = `${base}/contact?piece=${encodeURIComponent(title)}`;
const detailUrl = `${base}/works/${encodeURIComponent(catalog)}`;
---

<article class="card">
  <a href={detailUrl} class="frame-link">
    <div class="frame">
      <img src={image} alt={title} loading="lazy" transition:name={`artwork-${catalog}`} />
      {isSold && <span class="sold-tag">Sold</span>}
      <div class="image-overlay">
        <div class="overlay-content">
          <span class="overlay-catalog">{catalog}</span>
          <span class="overlay-title">{title}</span>
          <span class="overlay-meta">{year} &middot; {price}</span>
        </div>
      </div>
      <div class="custom-cursor" aria-hidden="true">
        <span>View</span>
      </div>
    </div>
  </a>
  <div class="label">
    <span class="catalog">{catalog}</span>
    <h3 class="title">
      <a href={detailUrl}>{title}</a>
    </h3>
    <p class="meta">{medium}, {year} &middot; {size}</p>
    <div class="row">
      <span class="price">{price}</span>
      {isSold ? (
        <span class="status status-sold">Sold</span>
      ) : (
        <a class="inquire" href={contactUrl}>Inquire →</a>
      )}
    </div>
  </div>
</article>

<script>
  function initArtworkCards() {
    const cards = document.querySelectorAll('.card');
    cards.forEach(card => {
      const frame = card.querySelector('.frame-link');
      const cursor = card.querySelector('.custom-cursor') as HTMLElement;
      if (!frame || !cursor) return;

      const onMouseMove = (e: MouseEvent) => {
        const rect = frame.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        cursor.style.transform = `translate(${x}px, ${y}px) translate(-50%, -50%)`;
      };

      frame.addEventListener('mousemove', onMouseMove as EventListener);
    });
  }

  document.addEventListener('DOMContentLoaded', initArtworkCards);
  document.addEventListener('astro:page-load', initArtworkCards);
</script>

<style>
  .card {
    display: flex;
    flex-direction: column;
  }

  .frame-link {
    display: block;
    text-decoration: none;
    cursor: none;
  }

  .frame-link:hover {
    cursor: none;
  }

  .frame {
    position: relative;
    background: #fff;
    padding: 10px;
    box-shadow:
      0 1px 2px rgba(32, 29, 26, 0.08),
      0 12px 24px -12px rgba(32, 29, 26, 0.35);
    transition: transform 250ms var(--ease-standard), box-shadow 250ms var(--ease-standard);
  }

  .frame-link:hover .frame {
    transform: scale(1.03);
    box-shadow:
      0 4px 8px rgba(32, 29, 26, 0.12),
      0 20px 36px -16px rgba(32, 29, 26, 0.45);
  }

  .frame img {
    width: 100%;
    height: auto;
  }

  .sold-tag {
    position: absolute;
    top: 18px;
    right: 18px;
    font-family: var(--font-label);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--wall);
    color: var(--umber);
    padding: 3px 8px;
    border: 1px solid var(--line);
    z-index: 2;
  }

  .image-overlay {
    position: absolute;
    inset: 10px;
    background: rgba(32, 29, 26, 0.65);
    display: flex;
    align-items: flex-end;
    padding: 24px;
    opacity: 0;
    transition: opacity 250ms var(--ease-standard);
    color: #fff;
    z-index: 1;
  }

  .frame-link:hover .image-overlay {
    opacity: 1;
  }

  .overlay-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .overlay-catalog {
    font-family: var(--font-label);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--wall);
  }

  .overlay-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
  }

  .overlay-meta {
    font-family: var(--font-label);
    font-size: 0.8rem;
    color: var(--wall);
  }

  .custom-cursor {
    position: absolute;
    top: 0;
    left: 0;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-label);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.8);
    transition: opacity 200ms ease, transform 200ms ease;
    z-index: 10;
  }

  .frame-link:hover .custom-cursor {
    opacity: 0.95;
    transform: translate(-50%, -50%) scale(1);
  }

  .label {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }

  .catalog {
    display: block;
    font-family: var(--font-label);
    font-size: 0.7rem;
    color: var(--umber);
    letter-spacing: 0.08em;
    margin-bottom: 4px;
  }

  .title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.15rem;
    margin: 0 0 4px;
    line-height: 1.25;
  }

  .title a {
    text-decoration: none;
    color: inherit;
  }

  .title a:hover {
    color: var(--accent);
  }

  .meta {
    margin: 0 0 10px;
    font-size: 0.85rem;
    color: var(--umber);
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .price {
    font-family: var(--font-label);
    font-size: 0.95rem;
    color: var(--ink);
  }

  .inquire {
    font-family: var(--font-label);
    font-size: 0.8rem;
    text-decoration: none;
    color: var(--accent);
    border-bottom: 1px solid var(--accent);
    padding-bottom: 1px;
    transition: opacity var(--duration-fast) ease;
  }

  .inquire:hover {
    opacity: 0.7;
  }

  .status-sold {
    font-family: var(--font-label);
    font-size: 0.8rem;
    color: var(--sold);
  }

  @media (prefers-reduced-motion: reduce), (hover: none) {
    .frame-link {
      cursor: pointer;
    }
    .custom-cursor,
    .image-overlay {
      display: none;
    }
    .frame-link:hover .frame {
      transform: none;
      box-shadow: 0 1px 2px rgba(32, 29, 26, 0.08), 0 12px 24px -12px rgba(32, 29, 26, 0.35);
    }
  }
</style>
