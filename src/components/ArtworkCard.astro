---

interface Props {
  catalog: string;
  title: string;
  year: string;
  medium: string;
  size: string;
  price: string;
  status: 'available' | 'sold';
  width: number;
  height: number;
  thumbnail: string;
  srcset: string;
  alt: string;
  lqip?: string;
}

const { catalog, title, year, medium, size, price, status, width, height, thumbnail, srcset, alt, lqip } = Astro.props;
const isSold = status === 'sold';
import { base } from '../lib/site';
const contactUrl = `${base}/contact/?piece=${encodeURIComponent(title)}`;
const detailUrl = `${base}/works/${encodeURIComponent(catalog)}/`;
---

<article class="card">
  <a href={detailUrl} class="frame-link">
    <div class="frame">
      <img
        width={width} height={height}
        src={thumbnail}
        srcset={srcset}
        sizes="(max-width: 400px) calc(100vw - 60px), (max-width: 1000px) calc(90vw - 20px), 880px"
        alt={alt}
        style={lqip ? {backgroundImage: `url(${lqip})`, backgroundSize: "cover"} : undefined}
        loading="lazy"
        transition:name={`artwork-${catalog}`}
      />
      {isSold && <span class="sold-tag">Sold</span>}
    </div>
  </a>
  <div class="label">
    <span class="catalog">{catalog}</span>
    <h3 class="title">
      <a href={detailUrl}>{title}</a>
    </h3>
    <p class="meta">{medium}, {year} &middot; {size}</p>
    <div class="row">
      <span class="price">{price}</span>
      {isSold ? (
        <span class="status status-sold">Sold</span>
      ) : (
        <a class="inquire" href={contactUrl}>Inquire →</a>
      )}
    </div>
  </div>
</article>


<style>
  .card {
    display: flex;
    flex-direction: column;
  }

  .frame-link {
    display: block;
    text-decoration: none;
    cursor: pointer;
  }

  .frame-link:hover {
    cursor: pointer;
  }

  .frame {
    position: relative;
    background: #fff;
    padding: 10px;
    box-shadow:
      0 1px 2px rgba(32, 29, 26, 0.08),
      0 12px 24px -12px rgba(32, 29, 26, 0.35);
    transition: transform 250ms var(--ease-standard), box-shadow 250ms var(--ease-standard);
  }

  .frame-link:hover .frame {
    transform: scale(1.03);
    box-shadow:
      0 4px 8px rgba(32, 29, 26, 0.12),
      0 20px 36px -16px rgba(32, 29, 26, 0.45);
  }

  .frame img {
    width: 100%;
    height: auto;
  }

  .sold-tag {
    position: absolute;
    top: 18px;
    right: 18px;
    font-family: var(--font-label);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--wall);
    color: var(--umber);
    padding: 3px 8px;
    border: 1px solid var(--line);
    z-index: 2;
  }

  .label {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }

  .catalog {
    display: block;
    font-family: var(--font-label);
    font-size: 0.7rem;
    color: var(--umber);
    letter-spacing: 0.08em;
    margin-bottom: 4px;
  }

  .title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.15rem;
    margin: 0 0 4px;
    line-height: 1.25;
  }

  .title a {
    text-decoration: none;
    color: inherit;
  }

  .title a:hover {
    color: var(--accent);
  }

  .meta {
    margin: 0 0 10px;
    font-size: 0.85rem;
    color: var(--umber);
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .price {
    font-family: var(--font-label);
    font-size: 0.95rem;
    color: var(--ink);
  }

  .inquire {
    font-family: var(--font-label);
    font-size: 0.8rem;
    text-decoration: none;
    color: var(--accent);
    border-bottom: 1px solid var(--accent);
    padding-bottom: 1px;
    transition: opacity var(--duration-fast) ease;
  }

  .inquire:hover {
    opacity: 0.7;
  }

  .status-sold {
    font-family: var(--font-label);
    font-size: 0.8rem;
    color: var(--sold);
  }

  @media (prefers-reduced-motion: reduce), (hover: none) {
    .frame-link {
      cursor: pointer;
    }
    .frame-link:hover .frame {
      transform: none;
      box-shadow: 0 1px 2px rgba(32, 29, 26, 0.08), 0 12px 24px -12px rgba(32, 29, 26, 0.35);
    }
  }
</style>
