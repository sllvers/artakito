---
import artist from '../data/artist.json';
import artworks from '../data/artworks.json';

const years = [...new Set(artworks.map((a) => a.year))].sort((a, b) => b.localeCompare(a));
const rawBase = import.meta.env.BASE_URL;
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');
const homeUrl = base || '/';
---

<header class="site-header">
  <a class="logo-link" href={homeUrl}>
    <img src={`${base}/artworks/logo3.svg`} alt={artist.name} class="logo" />
  </a>

  <div class="right">
    <a class="contact-link" href={`${base}/contact`}>Contact</a>
    <details class="menu">
      <summary>Works</summary>
      <nav class="dropdown">
        <a href={`${base}/works`}>All Works</a>
        {years.map((y) => (
          <a href={`${base}/works?year=${y}`}>{y}</a>
        ))}
      </nav>
    </details>
  </div>
</header>

<script>
  // Close the menu when clicking outside it
  document.addEventListener('click', (e) => {
    document.querySelectorAll('details.menu').forEach((el) => {
      if (!(el as HTMLElement).contains(e.target as Node)) {
        el.removeAttribute('open');
      }
    });
  });
</script>

<style>
  .site-header {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 80px;
    padding: 0 clamp(16px, 3vw, 40px);
    box-sizing: border-box;
    width: 100%;
    background: linear-gradient(to bottom, rgba(237, 233, 225, 0.85), rgba(237, 233, 225, 0.4));
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(216, 210, 198, 0.3);
  }

  .logo-link {
    display: flex;
    align-items: center;
    height: 100%;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }

  .logo-link:hover {
    opacity: 0.75;
  }

  .logo {
    max-height: 52px;
    width: auto;
    object-fit: contain;
    border-radius: 2px;
  }

  .right {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .contact-link {
    font-family: var(--font-label);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--ink);
    opacity: 0.85;
    transition: opacity 0.15s ease;
  }

  .contact-link:hover {
    opacity: 1;
    color: var(--accent);
  }

  .menu {
    position: relative;
  }

  .menu summary {
    list-style: none;
    cursor: pointer;
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--wall);
    user-select: none;
    transition: opacity 0.15s ease;
  }

  .menu summary:hover {
    opacity: 0.9;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu summary::after {
    content: '▾';
    margin-left: 5px;
    opacity: 0.7;
  }

  .menu[open] summary::after {
    content: '▴';
  }

  .dropdown {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    display: flex;
    flex-direction: column;
    min-width: 140px;
    background: var(--wall);
    border: 1px solid var(--line);
    box-shadow: 0 10px 25px -5px rgba(32, 29, 26, 0.15);
    z-index: 1000;
  }

  .dropdown a {
    padding: 8px 12px;
    font-family: var(--font-label);
    font-size: 0.75rem;
    text-decoration: none;
    color: var(--ink);
    border-bottom: 1px solid var(--line);
  }

  .dropdown a:last-child {
    border-bottom: none;
  }

  .dropdown a:hover {
    background: rgba(75, 93, 69, 0.08);
    color: var(--accent);
  }
</style>
