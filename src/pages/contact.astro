---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import artist from '../data/artist.json';
import artworks from '../data/artworks.json';

const backgroundImage = artworks[0]?.image ?? '';
const piece = Astro.url.searchParams.get('piece');
const rawBase = import.meta.env.BASE_URL;
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');
---

<Layout title={`Contact — ${artist.name}`}>
  <div class="page">
    <img class="bg" src={backgroundImage} alt="" aria-hidden="true" />
    <div class="scrim"></div>

    <div class="content">
      <Nav />

      <section class="contact">
        <h1>Contact</h1>

        <div class="grid">
          <div class="intro">
            {piece ? (
              <p class="inquiry-title">Inquiring about: <strong>{piece}</strong></p>
            ) : (
              <p>To contact the artist, please fill out the form.</p>
            )}
            <p class="or">Or write directly to <a href={`mailto:${artist.inquireEmail}`}>{artist.inquireEmail}</a>.</p>

            {artist.instagram && (
              <div class="socials">
                <a href={artist.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="2" y="2" width="20" height="20" rx="5" />
                    <circle cx="12" cy="12" r="4.5" />
                    <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
                  </svg>
                </a>
              </div>
            )}
          </div>

          <form class="form" action={artist.formEndpoint} method="POST">
            <input type="hidden" name="piece" value={piece || ''} />
            <input type="hidden" name="_subject" value={piece ? `Inquiry about ${piece}` : 'General Inquiry'} />
            <div class="row">
              <label>
                <span>First Name</span>
                <input type="text" name="firstName" autocomplete="given-name" />
              </label>
              <label>
                <span>Last Name</span>
                <input type="text" name="lastName" autocomplete="family-name" />
              </label>
            </div>
            <div class="row">
              <label>
                <span>Email *</span>
                <input type="email" name="email" required autocomplete="email" />
              </label>
              <label>
                <span>Subject</span>
                <input type="text" name="subject" value={piece ? `Inquiry about ${piece}` : ''} />
              </label>
            </div>
            <label class="message">
              <span>Message</span>
              <textarea name="message" rows="4" required></textarea>
            </label>
            <button type="submit">Submit</button>
          </form>
        </div>
      </section>

      <footer class="site-footer">
        <p class="fine">&copy; {new Date().getFullYear()} {artist.name} &bull; <a href={`${base}/privacy-policy`}>Privacy Policy</a></p>
      </footer>
    </div>
  </div>
</Layout>

<style>
  .page {
    position: relative;
    min-height: 100vh;
  }

  .bg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.4) blur(1px);
  }

  .scrim {
    position: fixed;
    inset: 0;
    background: var(--wall);
    opacity: 0.88;
  }

  .content {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .contact {
    flex: 1;
    padding: 110px clamp(20px, 5vw, 64px) 60px;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    text-align: center;
    letter-spacing: 0.04em;
    margin: 0 0 56px;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 48px;
    max-width: 980px;
    margin: 0 auto;
    align-items: start;
  }

  .intro p {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.6;
    margin: 0 0 10px;
  }

  .inquiry-title {
    font-size: 1.1rem;
    color: var(--accent);
  }

  .intro .or {
    color: var(--umber);
    font-size: 0.9rem;
  }

  .intro a {
    color: var(--accent);
  }

  .socials {
    margin-top: 28px;
    display: flex;
    gap: 14px;
  }

  .socials a {
    color: var(--ink);
    transition: color 0.15s ease;
  }

  .socials a:hover {
    color: var(--accent);
  }

  .form {
    background: rgba(237, 233, 225, 0.6);
    border: 1px solid var(--line);
    padding: 32px;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 22px;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  label span {
    font-family: var(--font-label);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: var(--umber);
  }

  input,
  textarea {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--ink);
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--line);
    padding: 6px 0;
    outline: none;
  }

  input:focus,
  textarea:focus {
    border-bottom-color: var(--accent);
  }

  .message {
    margin-bottom: 26px;
  }

  textarea {
    resize: vertical;
    font-family: var(--font-body);
  }

  button[type='submit'] {
    width: 100%;
    padding: 12px;
    font-family: var(--font-label);
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    background: var(--ink);
    color: var(--wall);
    border: none;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  button[type='submit']:hover {
    opacity: 0.85;
  }

  .site-footer {
    text-align: center;
    padding: 24px 0 32px;
  }

  .fine {
    font-family: var(--font-label);
    font-size: 0.75rem;
    color: var(--umber);
  }

  .fine a {
    color: inherit;
    text-decoration: underline;
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .row {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }
</style>
