---
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import { artist } from '../lib/content';
import { artworks } from '../lib/content';

import {formEndpoint} from '../lib/site';
const backgroundImage = artworks[0]?.image ?? '';
---

<Layout title={`Contact — ${artist.name}`}>
  <div class="page">
    <img class="bg" src={backgroundImage} srcset={artworks[0]?.srcset} sizes="100vw" width={artworks[0]?.width} height={artworks[0]?.height} alt="" aria-hidden="true" />
    <div class="scrim"></div>

    <div class="content">
      <Nav />

      <main class="contact">
        <h1>Contact</h1>

        <div class="grid">
          <div class="intro">
            <p id="general-inquiry">To contact the artist, please fill out the form.</p>
            <p id="artwork-inquiry" class="inquiry-title" hidden>Inquiring about: <strong></strong></p>
            <p class="or">Or write directly to {artist.inquireEmail}.</p>

            {artist.instagram && (
              <div class="socials">
                <a href={artist.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="2" y="2" width="20" height="20" rx="5" />
                    <circle cx="12" cy="12" r="4.5" />
                    <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
                  </svg>
                </a>
              </div>
            )}
          </div>

          <form id="contact-form" class="form" action={formEndpoint} method="POST">
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="honeypot" />
            <input type="hidden" name="piece" />
            <input type="hidden" name="_subject" value="General Inquiry" />
            <div class="row">
              <label>
                <span>First Name</span>
                <input type="text" name="firstName" autocomplete="given-name" />
              </label>
              <label>
                <span>Last Name</span>
                <input type="text" name="lastName" autocomplete="family-name" />
              </label>
            </div>
            <div class="row">
              <label>
                <span>Email *</span>
                <input type="email" name="email" required autocomplete="email" />
              </label>
              <label>
                <span>Subject</span>
                <input type="text" name="subject" />
              </label>
            </div>
            <label class="message">
              <span>Message</span>
              <textarea name="message" rows="4" required></textarea>
            </label>
            <button type="submit">Submit</button>
            <p id="form-status" role="status" aria-live="polite"></p>
          </form>
        </div>
      </main>

      <Footer />
    </div>
  </div>
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    const form = document.querySelector<HTMLFormElement>('#contact-form');
    const general = document.getElementById('general-inquiry');
    const inquiry = document.getElementById('artwork-inquiry');
    const title = inquiry?.querySelector('strong');
    if (!form || !general || !inquiry || !title) return;

    if (!form.dataset.bound) {
      form.dataset.bound = 'true';
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
        const status = form.querySelector<HTMLElement>('#form-status')!;
        button.disabled = true;
        status.textContent = 'Sending…';
        try {
          const response = await fetch(form.action, {method: 'POST', body: new FormData(form), headers: {Accept: 'application/json'}});
          if (!response.ok) throw new Error('Submission failed');
          status.textContent = 'Thank you. Your message has been sent.';
          form.querySelector<HTMLTextAreaElement>('textarea')!.value = '';
        } catch {
          status.textContent = 'Your message could not be confirmed. Please try again or use the email shown on this page.';
        } finally { button.disabled = false; }
      });
    }
    const piece = new URLSearchParams(window.location.search).get('piece')?.trim() ?? '';
    const subject = piece ? `Inquiry about ${piece}` : '';
    general.hidden = Boolean(piece);
    inquiry.hidden = !piece;
    title.textContent = piece;
    form.querySelector<HTMLInputElement>('input[name="piece"]')!.value = piece;
    form.querySelector<HTMLInputElement>('input[name="_subject"]')!.value = subject || 'General Inquiry';
    form.querySelector<HTMLInputElement>('input[name="subject"]')!.value = subject;
  });
</script>

<style>
  .honeypot { position: absolute; left: -10000px; width: 1px; height: 1px; }
  button:disabled { opacity: .6; cursor: wait; }
  .page {
    position: relative;
    min-height: 100vh;
  }

  .bg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.4) blur(1px);
  }

  .scrim {
    position: fixed;
    inset: 0;
    background: var(--wall);
    opacity: 0.88;
  }

  .content {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .contact {
    flex: 1;
    padding: 110px clamp(20px, 5vw, 64px) 60px;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    text-align: center;
    letter-spacing: 0.04em;
    margin: 0 0 56px;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 48px;
    max-width: 980px;
    margin: 0 auto;
    align-items: start;
  }

  .intro p {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.6;
    margin: 0 0 10px;
  }

  .inquiry-title {
    font-size: 1.1rem;
    color: var(--accent);
  }

  .intro .or {
    color: var(--umber);
    font-size: 0.9rem;
  }

  .intro a {
    color: var(--accent);
  }

  .socials {
    margin-top: 28px;
    display: flex;
    gap: 14px;
  }

  .socials a {
    color: var(--ink);
    transition: color 0.15s ease;
  }

  .socials a:hover {
    color: var(--accent);
  }

  .form {
    background: rgba(237, 233, 225, 0.6);
    border: 1px solid var(--line);
    padding: 32px;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 22px;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  label span {
    font-family: var(--font-label);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: var(--umber);
  }

  input,
  textarea {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--ink);
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--line);
    padding: 6px 0;
    outline: none;
  }

  input:focus,
  textarea:focus {
    border-bottom-color: var(--accent);
  }

  .message {
    margin-bottom: 26px;
  }

  textarea {
    resize: vertical;
    font-family: var(--font-body);
  }

  button[type='submit'] {
    width: 100%;
    padding: 12px;
    font-family: var(--font-label);
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    background: var(--ink);
    color: var(--wall);
    border: none;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  button[type='submit']:hover {
    opacity: 0.85;
  }




  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .row {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }
</style>
