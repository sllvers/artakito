---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import artist from '../data/artist.json';
import artworks from '../data/artworks.json';

const subject = encodeURIComponent('Inquiry — general');
const mailto = `mailto:${artist.inquireEmail}?subject=${subject}`;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');
---

<Layout title={`Works — ${artist.name}`}>
  <Nav />

  <section class="page-heading">
    <h1 id="page-title">Works</h1>
  </section>

  <section class="gallery" id="gallery-container">
    {artworks.map((a, index) => (
      <div class="gallery-item" data-year={a.year} style={`--stagger-index: ${index};`}>
        <div class="artwork-showcase-wrapper">
          <ArtworkCard {...a} />
        </div>
      </div>
    ))}
  </section>

  <footer class="site-footer">
    <p>For inquiries, availability, or studio visits, write to <a href={mailto}>{artist.inquireEmail}</a>.</p>
    <p class="fine">&copy; {new Date().getFullYear()} {artist.name} &bull; <a href={`${base}/privacy-policy`}>Privacy Policy</a></p>
  </footer>
</Layout>

<script>
  function initGalleryFilterAndReveal() {
    const params = new URLSearchParams(window.location.search);
    const requestedYear = params.get('year');
    
    const titleEl = document.getElementById('page-title');
    if (titleEl) {
      titleEl.textContent = requestedYear ? `Works, ${requestedYear}` : 'Works';
    }

    const items = document.querySelectorAll('.gallery-item') as NodeListOf<HTMLElement>;
    items.forEach(item => {
      const itemYear = item.getAttribute('data-year');
      if (!requestedYear || itemYear === requestedYear) {
        item.style.display = '';
      } else {
        item.style.display = 'none';
      }
    });

    const visibleItems = Array.from(items).filter(item => item.style.display !== 'none');
    const observer = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('reveal');
          obs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.05, rootMargin: '0px 0px -50px 0px' });

    visibleItems.forEach(item => observer.observe(item));
  }

  document.addEventListener('DOMContentLoaded', initGalleryFilterAndReveal);
  document.addEventListener('astro:page-load', initGalleryFilterAndReveal);
</script>

<style>
  .page-heading {
    padding: 110px clamp(20px, 5vw, 64px) 32px;
  }

  .page-heading h1 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin: 0;
  }

  .gallery {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 clamp(20px, 5vw, 64px) 80px;
    gap: 96px;
  }

  .gallery-item {
    width: 100%;
    max-width: 900px;
    min-height: 70vh;
    opacity: 0;
    transform: translateY(20px) scale(0.96);
    transition: opacity var(--duration-base) var(--ease-standard), transform var(--duration-base) var(--ease-standard);
  }

  .gallery-item.reveal {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .artwork-showcase-wrapper {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .site-footer {
    border-top: 1px solid var(--line);
    padding: 32px clamp(20px, 5vw, 64px) 48px;
    text-align: center;
  }

  .site-footer p {
    margin: 0 0 6px;
    font-size: 0.9rem;
  }

  .site-footer a {
    color: var(--accent);
  }

  .fine {
    font-family: var(--font-label);
    font-size: 0.75rem;
    color: var(--umber);
  }

  .fine a {
    color: inherit;
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
