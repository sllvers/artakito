---
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import { artist } from '../lib/content';
import { artworks } from '../lib/content';

---

<Layout title={`Works — ${artist.name}`}>
  <Nav />

  <main>
  <section class="page-heading">
    <h1 id="page-title">Works</h1>
  </section>

  <section class="gallery" id="gallery-container">
    {artworks.map((a) => (
      <div class="gallery-item" data-year={a.year}>
        <div class="artwork-showcase-wrapper">
          <ArtworkCard {...a} />
        </div>
      </div>
    ))}
  </section>

  </main>
  <Footer inquiries />
</Layout>

<script>
  function initGalleryFilter() {
    const params = new URLSearchParams(window.location.search);
    const requestedYear = params.get('year');
    
    const titleEl = document.getElementById('page-title');
    if (titleEl) {
      titleEl.textContent = requestedYear ? `Works, ${requestedYear}` : 'Works';
    }

    const items = document.querySelectorAll('.gallery-item') as NodeListOf<HTMLElement>;
    items.forEach(item => {
      const itemYear = item.getAttribute('data-year');
      if (!requestedYear || itemYear === requestedYear) {
        item.style.display = '';
      } else {
        item.style.display = 'none';
      }
    });


  }

  document.addEventListener('astro:page-load', initGalleryFilter);
</script>

<style>
  .page-heading {
    padding: 110px clamp(20px, 5vw, 64px) 32px;
  }

  .page-heading h1 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin: 0;
  }

  .gallery {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 clamp(20px, 5vw, 64px) 80px;
    gap: 96px;
  }

  .gallery-item {
    width: 100%;
    max-width: 900px;
    min-height: 70vh;
    opacity: 1;


  }


  .artwork-showcase-wrapper {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }






  @media (max-width: 767px) {
    .gallery {
      gap: 48px;
    }

    .gallery-item {
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
