---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import { artist } from '../lib/content';
import { artworks } from '../lib/content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const worksUrl = `${base}/works/`;
const ranges = artworks.find((artwork) => artwork.catalog === '001');
---

<Layout>
  <Nav />

  <section class="portrait">
    <img src={artist.photo} alt={artist.name} />
    <div class="hero-caption">
      <h1>{artist.name}</h1>
      <a href={worksUrl}>View Works →</a>
    </div>
  </section>

  <div class="content-wrapper">
    <section class="bio-container" aria-labelledby="artist-note">
      <div class="bio-opening">
        <div class="bio-content">
          <h2 id="artist-note">Artist Note</h2>
          <blockquote>“{artist.bio.quote}”</blockquote>
          <p>{artist.bio.roots}</p>
          <h3>A shift away from realism</h3>
          <p>{artist.bio.turningPoint}</p>
        </div>
        {ranges && (
          <figure class="bio-artwork">
            <img
              src={ranges.thumbnail}
              srcset={ranges.srcset}
              sizes="(min-width: 800px) 48vw, 90vw"
              alt="Detail of Ranges showing pale paint drips beneath a dark, curved ridge"
              loading="lazy"
            />
            <figcaption>
              <a href={`${worksUrl}${ranges.catalog}/`}><cite>{ranges.title}</cite>, {ranges.year} · View full work →</a>
            </figcaption>
          </figure>
        )}
      </div>
      <div class="bio-content bio-closing">
        <h3>Landscapes of lived experience</h3>
        <p>{artist.bio.practice}</p>
        <a class="bio-link" href={worksUrl}>Explore the work →</a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .portrait {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100dvh;
    margin: 0;
    overflow: hidden;
    z-index: 1;
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    box-shadow: none;
    transform: scale(1);
    transition: transform 0.1s ease-out;
  }

  .hero-caption {
    position: absolute;
    inset: auto 0 0;
    padding: 64px clamp(20px, 5vw, 64px) clamp(24px, 5vw, 56px);
    background: linear-gradient(transparent, rgba(32, 29, 26, 0.82));
    color: #fff;
  }

  .hero-caption h1 {
    font: 500 clamp(2.6rem, 6vw, 4.5rem)/1 var(--font-display);
    margin: 0 0 12px;
  }

  .hero-caption a {
    display: inline-block;
    padding: 10px 16px;
    background: var(--wall);
    color: var(--ink);
    font: 0.9rem var(--font-label);
    text-decoration: none;
  }

  .hero-caption a:hover {
    text-decoration: underline;
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .portrait img {
        animation: heroScale linear both;
        animation-timeline: scroll(root);
        animation-range: 0vh 100vh;
      }
    }
  }

  @keyframes heroScale {
    to {
      transform: scale(1.05);
      opacity: 0.85;
    }
  }

  .content-wrapper {
    position: relative;
    z-index: 2;
    background: var(--wall);
    box-shadow: 0 -20px 40px rgba(32, 29, 26, 0.05);
    margin-bottom: 0;
  }

  .bio-container {
    max-width: 1320px;
    margin: 0 auto;
    padding: clamp(48px, 8vw, 112px) clamp(20px, 5vw, 64px);
  }

  .bio-opening {
    display: grid;
    gap: clamp(32px, 6vw, 88px);
    align-items: start;
  }

  @media (min-width: 800px) {
    .bio-opening {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .bio-content {
    max-width: 60ch;
  }

  .bio-content h2 {
    margin: 0 0 24px;
    color: var(--accent);
    font: 500 0.8rem var(--font-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .bio-content blockquote {
    margin: 0 0 32px;
    font: 500 clamp(1.85rem, 3.5vw, 3.5rem)/1.14 var(--font-display);
    text-wrap: pretty;
  }

  .bio-content h3 {
    margin: 28px 0 8px;
    font: 500 clamp(1.25rem, 2vw, 1.65rem)/1.25 var(--font-display);
  }

  .bio-content p {
    font-family: var(--font-body);
    font-size: 1.1rem;
    line-height: 1.75;
    color: var(--ink);
    margin: 0;
  }

  .bio-artwork {
    margin: 0;
  }

  .bio-artwork img {
    width: 100%;
    aspect-ratio: 5 / 6;
    object-fit: cover;
    object-position: 63% center;
  }

  .bio-artwork figcaption,
  .bio-link {
    font: 0.85rem/1.5 var(--font-label);
    color: var(--accent);
  }

  .bio-artwork figcaption {
    margin-top: 12px;
  }

  .bio-closing {
    margin-top: clamp(32px, 5vw, 64px);
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .bio-closing h3 {
    margin-top: 0;
  }

  .bio-link {
    display: inline-block;
    margin-top: 20px;
  }
</style>
