---
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import { artist } from '../lib/content';
import { artworks } from '../lib/content';

import {base} from '../lib/site';
const worksUrl = `${base}/works/`;
const featuredArtwork = artworks.find((artwork) => artwork.featured);
---

<Layout>
  <Nav />

  <main>
  <section class="portrait">
    <img src={artist.photo} srcset={artist.photoSrcset} sizes="100vw" width={artist.width} height={artist.height} fetchpriority="high" alt={artist.name} />
    <div class="hero-caption">
      <h1>{artist.name}</h1>
      <a href={worksUrl}>View Works →</a>
    </div>
  </section>

  <div class="content-wrapper">
    <section class="bio-container" aria-labelledby="artist-note">
      <header class="bio-opening">
        <div class="bio-content">
          <h2 id="artist-note">Artist Note</h2>
          <blockquote>“{artist.bio.quote}”</blockquote>
          <p>{artist.bio.roots}</p>
        </div>
      </header>
        {featuredArtwork && (
          <figure class="bio-artwork">
            <img
              src={featuredArtwork.thumbnail}
              srcset={featuredArtwork.srcset}
              sizes="(min-width: 1080px) 960px, 90vw"
              alt={featuredArtwork.alt}
              width={featuredArtwork.width} height={featuredArtwork.height}
              loading="lazy"
            />
            <figcaption>
              <a href={`${worksUrl}${featuredArtwork.catalog}/`}><cite>{featuredArtwork.title}</cite>, {featuredArtwork.year} · View full work →</a>
            </figcaption>
          </figure>
        )}
      <div class="bio-content bio-story">
        <h3>{artist.bio.turningPointHeading}</h3>
        <p>{artist.bio.turningPoint}</p>
        <h3>{artist.bio.practiceHeading}</h3>
        <p>{artist.bio.practice}</p>
        <a class="bio-link" href={worksUrl}>Explore the work →</a>
      </div>
    </section>
  </div>
  </main>
  <Footer />
</Layout>

<style>
  .portrait {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100dvh;
    margin: 0;
    overflow: hidden;
    z-index: 1;
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    box-shadow: none;
    transform: scale(1);
    transition: transform 0.1s ease-out;
  }

  .hero-caption {
    position: absolute;
    inset: auto 0 0;
    padding: 64px clamp(20px, 5vw, 64px) clamp(24px, 5vw, 56px);
    background: linear-gradient(transparent, rgba(32, 29, 26, 0.82));
    color: #fff;
  }

  .hero-caption h1 {
    font: 500 clamp(2.6rem, 6vw, 4.5rem)/1 var(--font-display);
    margin: 0 0 12px;
  }

  .hero-caption a {
    display: inline-block;
    padding: 10px 16px;
    background: var(--wall);
    color: var(--ink);
    font: 0.9rem var(--font-label);
    text-decoration: none;
  }

  .hero-caption a:hover {
    text-decoration: underline;
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .portrait img {
        animation: heroScale linear both;
        animation-timeline: scroll(root);
        animation-range: 0vh 100vh;
      }
    }
  }

  @keyframes heroScale {
    to {
      transform: scale(1.05);
      opacity: 0.85;
    }
  }

  .content-wrapper {
    position: relative;
    z-index: 2;
    background: var(--wall);
    box-shadow: 0 -20px 40px rgba(32, 29, 26, 0.05);
    margin-bottom: 0;
  }

  .bio-container {
    max-width: 1080px;
    margin: 0 auto;
    padding: clamp(48px, 8vw, 112px) clamp(20px, 5vw, 60px);
  }

  .bio-opening {
    margin-bottom: clamp(32px, 5vw, 56px);
  }

  .bio-content {
    max-width: 68ch;
    margin-inline: auto;
  }

  .bio-content h2 {
    margin: 0 0 24px;
    color: var(--accent);
    font: 500 0.8rem var(--font-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .bio-content blockquote {
    margin: 0 0 32px;
    font: 500 clamp(1.85rem, 3.5vw, 3rem)/1.18 var(--font-display);
    text-wrap: pretty;
  }

  .bio-content h3 {
    margin: 28px 0 8px;
    font: 500 clamp(1.25rem, 2vw, 1.65rem)/1.25 var(--font-display);
  }

  .bio-content p {
    font-family: var(--font-body);
    font-size: 1.1rem;
    line-height: 1.75;
    color: var(--ink);
    margin: 0;
  }

  .bio-artwork {
    margin: 0;
  }

  .bio-artwork img {
    width: 100%;
    height: auto;
  }

  .bio-artwork figcaption,
  .bio-link {
    font: 0.85rem/1.5 var(--font-label);
    color: var(--accent);
  }

  .bio-artwork figcaption {
    margin-top: 12px;
  }

  .bio-story {
    margin-top: clamp(40px, 6vw, 72px);
  }

  .bio-story h3:first-child {
    margin-top: 0;
  }

  .bio-link {
    display: inline-block;
    margin-top: 20px;
  }
</style>
